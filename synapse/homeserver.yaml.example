# Synapse configuration for matrix-homeserver-stack
#
# Copy to ~/matrix/data/homeserver.yaml and replace:
#   - matrix.example.com    → your Matrix domain
#   - example.com           → your apex domain
#   - <PLACEHOLDER>         → generated secrets (see docs/INSTALL.md)
#
# Generate with:
#   docker run -it --rm -v ~/matrix/data:/data \
#     -e SYNAPSE_SERVER_NAME=matrix.example.com \
#     -e SYNAPSE_REPORT_STATS=no \
#     ghcr.io/element-hq/synapse:latest generate
#
# Then edit the generated file to match the settings below.

server_name: "matrix.example.com"
public_baseurl: "https://matrix.example.com/"
pid_file: /data/homeserver.pid

# ===== Listener =====
listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    bind_addresses: ['0.0.0.0']
    resources:
      - names: [client, federation]
        compress: false

# ===== Database (SQLite) =====
database:
  name: sqlite3
  args:
    database: /data/homeserver.db

log_config: "/data/matrix.example.com.log.config"
media_store_path: /data/media_store

# ===== Secrets (generated by `synapse generate`) =====
registration_shared_secret: "<PLACEHOLDER>"
macaroon_secret_key: "<PLACEHOLDER>"
form_secret: "<PLACEHOLDER>"
signing_key_path: "/data/matrix.example.com.signing.key"

trusted_key_servers:
  - server_name: "matrix.org"

# ===== MatrixRTC feature flags =====
experimental_features:
  msc3266_enabled: true
  msc4222_enabled: true
  msc4140_enabled: true
  msc4143_enabled: true
  msc4502_enabled: true
  msc4512_enabled: true

# ===== MatrixRTC transport discovery (MSC4143) =====
# This block MUST be present. Synapse serves
# /_matrix/client/unstable/org.matrix.msc4143/rtc/transports
# natively, with authentication.
#
# DO NOT add a static Caddy handler for this endpoint.
matrix_rtc:
  transports:
    - type: livekit
      livekit_service_url: https://matrix.example.com/livekit/jwt

# ===== Application Service registration (MSC4195) =====
# This file must exist in ~/matrix/data/ (see synapse/lk-jwt-as.yaml.example)
app_service_config_files:
  - /data/lk-jwt-as.yaml

# ===== Optional: suppress key server warning =====
# Uncomment if you see the "matrix.org key server" warning on startup
# suppress_key_server_warning: true
