# lk-jwt-service environment for matrix-homeserver-stack
#
# Copy to ~/matrix/rtc/lk-jwt/.env and replace:
#   - matrix.example.com       → your Matrix domain
#   - <LIVEKIT_API_KEY>        → same as livekit.yaml keys:
#   - <LIVEKIT_API_SECRET>     → same as livekit.yaml keys:
#   - <LIVEKIT_AS_TOKEN>       → generated 64-char hex (AS registration)
#   - <LIVEKIT_HS_TOKEN>       → generated 64-char hex (AS registration)
#
# Generate AS tokens with:
#   openssl rand -hex 32    # AS_TOKEN
#   openssl rand -hex 32    # HS_TOKEN
#
# These must match synapse/lk-jwt-as.yaml.example

# ===== LiveKit API credentials =====
# Must match the `keys:` block in livekit.yaml
LIVEKIT_URL=wss://matrix.example.com/livekit/sfu
LIVEKIT_KEY=<LIVEKIT_API_KEY>
LIVEKIT_SECRET=<LIVEKIT_API_SECRET>

# ===== Full-access homeservers =====
# Users from these homeservers can trigger LiveKit room creation.
# For a single-homeserver deployment, this is just your server.
LIVEKIT_FULL_ACCESS_HOMESERVERS=matrix.example.com

# ===== Application Service credentials =====
# Must match synapse/lk-jwt-as.yaml.example
LIVEKIT_AS_TOKEN=<LIVEKIT_AS_TOKEN>
LIVEKIT_HS_TOKEN=<LIVEKIT_HS_TOKEN>
LIVEKIT_HS_SERVER_NAME=matrix.example.com

# ===== Container port =====
# Must match the container-side port in rtc/docker-compose.yml
#   ports:
#     - "127.0.0.1:8081:8080"
#     - "172.17.0.1:8081:8080"
# The "8080" in those mappings is the container port.
PORT=8080

# ===== Optional: sanity check for stale participants =====
# Pull-based fallback when webhooks/delegation fail.
# Polls LiveKit every N seconds to verify participants are still connected.
# Uncomment to enable. See docs/TROUBLESHOOTING.md for details.
# LIVEKIT_SANITY_CHECK_INTERVAL_SECONDS=30
