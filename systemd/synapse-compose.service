[Unit]
Description=synapse Docker Compose
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/jonathon/matrix
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down --remove-orphans
TimeoutStopSec=60
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
